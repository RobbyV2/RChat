{
  "about": "Runs the server, or manages its accounts and keys",
  "args": [
    {
      "help": "Server host",
      "id": "host",
      "long": "host",
      "positional": false,
      "required": false,
      "short": "H",
      "value": "HOST"
    },
    {
      "help": "Server port",
      "id": "port",
      "long": "port",
      "positional": false,
      "required": false,
      "short": "p",
      "value": "PORT"
    },
    {
      "help": "App mode (full, api-only)",
      "id": "mode",
      "long": "mode",
      "positional": false,
      "required": false,
      "short": "m",
      "value": "MODE"
    },
    {
      "help": "Service roles: all, or a comma list of api, gateway, media, search, embeds, jobs, web, relay, sfu",
      "id": "roles",
      "long": "roles",
      "positional": false,
      "required": false,
      "short": null,
      "value": "ROLES"
    }
  ],
  "commands": [
    {
      "about": "Manage accounts in the instance's database. Works while the server runs",
      "args": [],
      "commands": [
        {
          "about": "Create an account with a temporary password. The first account administers the site",
          "args": [
            {
              "help": "The username",
              "id": "name",
              "long": null,
              "positional": true,
              "required": true,
              "short": null,
              "value": "NAME"
            },
            {
              "help": "The name shown for the account; the username when left out",
              "id": "display_name",
              "long": "display-name",
              "positional": false,
              "required": false,
              "short": null,
              "value": "DISPLAY_NAME"
            }
          ],
          "commands": [],
          "name": "create",
          "usage": "server user create [OPTIONS] <NAME>"
        },
        {
          "about": "Give an account a new temporary password and end its sessions",
          "args": [
            {
              "help": "The username",
              "id": "name",
              "long": null,
              "positional": true,
              "required": true,
              "short": null,
              "value": "NAME"
            }
          ],
          "commands": [],
          "name": "reset-password",
          "usage": "server user reset-password <NAME>"
        }
      ],
      "name": "user",
      "usage": "server user <COMMAND>"
    },
    {
      "about": "Manage the instance's encryption keys",
      "args": [],
      "commands": [
        {
          "about": "Print a new key for ENCRYPTION_KEYS. Nothing is stored",
          "args": [
            {
              "help": "The id of the key",
              "id": "id",
              "long": "id",
              "positional": false,
              "required": false,
              "short": null,
              "value": "ID"
            }
          ],
          "commands": [],
          "name": "new",
          "usage": "server keys new [OPTIONS]"
        },
        {
          "about": "Show where the keys come from, their fingerprints and the data keys they wrap",
          "args": [],
          "commands": [],
          "name": "status",
          "usage": "server keys status"
        },
        {
          "about": "Write the keys to a file protected by a passphrase, to keep off the server",
          "args": [
            {
              "help": "The file to write. It must not exist yet",
              "id": "out",
              "long": "out",
              "positional": false,
              "required": true,
              "short": null,
              "value": "OUT"
            },
            {
              "help": "A file holding the passphrase; it is asked for on the terminal when left out",
              "id": "passphrase_file",
              "long": "passphrase-file",
              "positional": false,
              "required": false,
              "short": null,
              "value": "PASSPHRASE_FILE"
            }
          ],
          "commands": [],
          "name": "export",
          "usage": "server keys export [OPTIONS] --out <OUT>"
        },
        {
          "about": "Open a file written by `keys export`: print its keys for ENCRYPTION_KEYS, or write them to a new key file",
          "args": [
            {
              "help": "The file `keys export` wrote",
              "id": "input",
              "long": "in",
              "positional": false,
              "required": true,
              "short": null,
              "value": "INPUT"
            },
            {
              "help": "A file holding the passphrase; it is asked for on the terminal when left out",
              "id": "passphrase_file",
              "long": "passphrase-file",
              "positional": false,
              "required": false,
              "short": null,
              "value": "PASSPHRASE_FILE"
            },
            {
              "help": "A key file to write, for ENCRYPTION_KEYS_FILE. It must not exist yet",
              "id": "out",
              "long": "out",
              "positional": false,
              "required": false,
              "short": null,
              "value": "OUT"
            }
          ],
          "commands": [],
          "name": "import",
          "usage": "server keys import [OPTIONS] --in <INPUT>"
        },
        {
          "about": "Store encrypted messages, their files, and the encrypted copies plain again: of every place, or of one server or DM. Stored secrets keep needing the keys",
          "args": [
            {
              "help": "Only this server",
              "id": "server",
              "long": "server",
              "positional": false,
              "required": false,
              "short": null,
              "value": "SERVER"
            },
            {
              "help": "Only this DM, by its id",
              "id": "dm",
              "long": "dm",
              "positional": false,
              "required": false,
              "short": null,
              "value": "DM"
            }
          ],
          "commands": [],
          "name": "unseal",
          "usage": "server keys unseal [OPTIONS]"
        },
        {
          "about": "Move every data key under the key in use now: the key service, else the first key of ENCRYPTION_KEYS. Run it once every copy has that key; copies that announce themselves (Redis) do it by themselves",
          "args": [],
          "commands": [],
          "name": "rewrap",
          "usage": "server keys rewrap"
        },
        {
          "about": "Rotate data keys: the next generation becomes active and what the old one sealed is sealed again; the old one is destroyed a day after. Every purpose, or one",
          "args": [
            {
              "help": "content, media, secrets, search or bus",
              "id": "purpose",
              "long": "purpose",
              "positional": false,
              "required": false,
              "short": null,
              "value": "PURPOSE"
            }
          ],
          "commands": [],
          "name": "rotate",
          "usage": "server keys rotate [OPTIONS]"
        }
      ],
      "name": "keys",
      "usage": "server keys <COMMAND>"
    },
    {
      "about": "Maintain the instance's database",
      "args": [],
      "commands": [
        {
          "about": "Rewrite the SQLite database so the pages deleted or rewritten text left behind are gone from the file. Stop the server first. Postgres: run VACUUM FULL (or pg_repack) instead",
          "args": [],
          "commands": [],
          "name": "compact",
          "usage": "server db compact"
        },
        {
          "about": "Write an encrypted backup of the SQLite database to PATH, for age recipients (--recipient or BACKUP_RECIPIENTS). The root keys are left out unless --with-keys. Postgres: use pg_dump",
          "args": [
            {
              "help": null,
              "id": "path",
              "long": null,
              "positional": true,
              "required": true,
              "short": null,
              "value": "PATH"
            },
            {
              "help": "An age X25519 recipient (age1...); give it more than once for several",
              "id": "recipients",
              "long": "recipient",
              "positional": false,
              "required": false,
              "short": null,
              "value": "RECIPIENTS"
            },
            {
              "help": "Put the root keys inside the encrypted backup too",
              "id": "with_keys",
              "long": "with-keys",
              "positional": false,
              "required": false,
              "short": null,
              "value": null
            }
          ],
          "commands": [],
          "name": "backup",
          "usage": "server db backup [OPTIONS] <PATH>"
        },
        {
          "about": "Check a backup: that it is one, and with --identity that it opens and every file matches its manifest",
          "args": [
            {
              "help": null,
              "id": "path",
              "long": null,
              "positional": true,
              "required": true,
              "short": null,
              "value": "PATH"
            },
            {
              "help": "An age identity file (AGE-SECRET-KEY-1...)",
              "id": "identity",
              "long": "identity",
              "positional": false,
              "required": false,
              "short": null,
              "value": "IDENTITY"
            }
          ],
          "commands": [],
          "name": "verify",
          "usage": "server db verify [OPTIONS] <PATH>"
        },
        {
          "about": "Restore a backup into the folder --to: the database, and the root keys when it holds them. It checks that every key the data needs is at hand",
          "args": [
            {
              "help": null,
              "id": "path",
              "long": null,
              "positional": true,
              "required": true,
              "short": null,
              "value": "PATH"
            },
            {
              "help": "An age identity file (AGE-SECRET-KEY-1...)",
              "id": "identity",
              "long": "identity",
              "positional": false,
              "required": true,
              "short": null,
              "value": "IDENTITY"
            },
            {
              "help": "A folder to write into; files there are never written over",
              "id": "to",
              "long": "to",
              "positional": false,
              "required": true,
              "short": null,
              "value": "TO"
            }
          ],
          "commands": [],
          "name": "restore",
          "usage": "server db restore --identity <IDENTITY> --to <TO> <PATH>"
        }
      ],
      "name": "db",
      "usage": "server db <COMMAND>"
    }
  ],
  "name": "server",
  "usage": "server [OPTIONS] [COMMAND]"
}
