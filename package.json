{
  "name": "rchat",
  "description": "Anonymous Material chat",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "dotenvx run --convention=nextjs --quiet -- bun run --cwd apps/web dev",
    "build": "dotenvx run --convention=nextjs --quiet -- bun run --cwd apps/web build",
    "start": "dotenvx run --convention=nextjs --quiet -- bun run --cwd apps/web start",
    "test:ui": "bun run --cwd apps/web test:ui",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs}\""
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "peer": "^1.0.2",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
