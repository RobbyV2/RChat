# Copy to .env.local: cp .env.local.example .env.local
# Lines that start with "# KEY=" show the default or an example.

# App
# full: one entry point for the API and the app. api-only: only the API.
APP_MODE=full
# The address the server listens on. Use 0.0.0.0 for remote access.
HOST=127.0.0.1
# The public port.
SERVER_PORT=3000
# The internal Next.js port.
PORT=3001
# The address Next.js listens on. Change it only if Next.js runs on another machine.
# FRONTEND_HOST=127.0.0.1
# Where non-API requests go in full mode. Default: http://127.0.0.1:${PORT}
# SERVER_PROXY_URL=http://127.0.0.1:3001
# API address for a frontend that runs apart from the API (build time).
# NEXT_PUBLIC_API_URL=http://localhost:3000
# WebSocket address when it is not on the API origin (build time).
# NEXT_PUBLIC_WS_URL=https://gateway.example.com

# Instance
# INSTANCE_NAME=RChat
# The address people open. Set it in production.
# PUBLIC_URL=https://chat.example.com
# Host names the instance answers for when PUBLIC_URL is not set.
# ALLOWED_HOSTS=chat.example.com
# Use these when the API, WebSocket or PeerJS server is on another address.
# PUBLIC_API_URL=https://api.example.com/api
# PUBLIC_WS_URL=wss://gateway.example.com
# PUBLIC_PEERJS_URL=https://chat.example.com/peerjs
# Ed25519 keys, base64url seeds separated by commas, or PEM. Default: a key stored in the database.
# INSTANCE_SIGNING_KEY=

# Database
# A sqlite file or a postgres:// URL. Use Postgres for more than one process.
# The database records its schema version. A build older than that version does not start,
# so do not run an older release against a database that a newer one upgraded. During an
# upgrade, stop all old processes before the new ones start.
# DATABASE_URL=rchat.db
# Postgres pool size per process. Sqlite ignores it.
# DATABASE_MAX_CONNECTIONS=8
# DATABASE_MIN_CONNECTIONS=0
# DATABASE_ACQUIRE_TIMEOUT_SECS=30
# Sqlite read pool size. Default: CPU count, 2 to 8. 0 sends reads to the writer.
# DATABASE_READ_CONNECTIONS=4

# Secrets
# By default these are made at first start and kept in the database, so a copy of the
# database holds them too. Set them here to keep them out of the database. Use the same
# values on all processes. NAME_FILE=/path reads the value from a file instead.
# Login tokens and guest grants are stored only as SHA-256 hashes and need no secret.
# Salt for server password lookups. Changing it, or setting it after first start, makes
# every extra server password (temporary passwords and tickets) stop working. Permanent
# server passwords and account passwords are not affected.
# PASSWORD_PEPPER=
# PASSWORD_PEPPER_FILE=/run/secrets/rchat_pepper
# Signs relay (TURN) logins. Changing it ends relay logins within an hour.
# RELAY_SECRET=
# Signs P2P file tokens. Changing it ends the tokens that were given out.
# P2P_SECRET=

# Storage
# Set the first four to store uploads in an S3 bucket instead of the database.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=rchat
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Scaling
# all, or a list of api, gateway, media, search, embeds, jobs, web, relay. Default: from APP_MODE.
# RCHAT_ROLES=all
# Shared state for many processes. Use a password and a private network. No TLS (rediss://).
# REDIS_URL=redis://:change-me@127.0.0.1:6379
# Key prefix, so many deployments can share one Redis.
# REDIS_PREFIX=rchat
# Entries kept in the realtime stream. Minimum 1000. Use the same value on all processes.
# REDIS_HUB_MAXLEN=100000
# Proxy addresses or CIDR ranges. Their X-Forwarded-For gives the real client address.
# TRUSTED_PROXIES=10.0.0.0/8,192.0.2.10
# Trust X-Forwarded-For from all peers. Only behind a proxy that overwrites it. Use TRUSTED_PROXIES instead.
# TRUST_PROXY=false
# Docker only: run the PeerJS server in this container (on or off).
# RCHAT_PEERJS=on

# Limits
# Requests per second per IP.
# RATE_LIMIT_PER_SECOND=10
# RATE_LIMIT_BURST=60
# Rate limits and server password budgets count per client address (an IPv6 /64 counts as one).
# Password attempts also count per network (IPv4 /24, IPv6 /48). People behind one shared
# address (carrier NAT, schools, offices) share these budgets, and one of them can use them up
# for the others. Behind a proxy, set TRUSTED_PROXIES, or every client counts as the proxy.
# A request without any peer address counts as 0.0.0.0, so all of those share one budget.
# Creating a server, changing one (PATCH /api/servers/{name}) and creating server passwords use
# the strict bucket, like logins.

# Guests
# First start only. After that, the site admin panel controls it.
# GUESTS_ENABLED=true
# Days until an unused guest server password grant expires. Each password has at most 2000
# live grants, and at most 50 per network (IPv4 /24, IPv6 /48), stored as a keyed hash.
# GUEST_GRANT_DAYS=30

# Attachments
# First start only. P2P files stay in the sender's browser and have no size limit.
# P2P_ATTACHMENTS=true

# Profanity
# First start only: on or off.
# PROFANITY_FILTER=on
# all, none, or a list of messages, links, usernames, server_names, channel_names, role_names, file_names, bios,
# channel_topics.
# PROFANITY_TARGETS=all

# Previews
# Days to keep link previews that no message uses.
# EMBED_CACHE_DAYS=30

# Voice
# Seconds until a voice room or call with one person ends.
# VOICE_IDLE_SECS=60
# Most people in one voice channel. 0 means no limit.
# VOICE_ROOM_MAX=25

# PeerJS
# The PeerJS server port.
# PEERJS_PORT=9001
# PeerJS port and host for the browser (build time). Default host: the page host.
# NEXT_PUBLIC_PEERJS_PORT=9001
# NEXT_PUBLIC_PEERJS_HOST=peer.example.com

# Relay
# Give calls public STUN servers from assets/stun_servers.json.
# PUBLIC_STUN=false
# How many public STUN servers, 1 to 4.
# PUBLIC_STUN_COUNT=3
# Run the built-in STUN and TURN relay. Set the same RELAY_ values on all processes.
# RELAY_ENABLED=false
# TURN needs RELAY_PUBLIC_IP.
# RELAY_TURN=true
# Default: the instance host.
# RELAY_HOST=relay.example.com
# RELAY_PORT=3478
# RELAY_PUBLIC_IP=203.0.113.10
# Relay port range. Reserve it: sysctl -w net.ipv4.ip_local_reserved_ports=49160-49415
# RELAY_MIN_PORT=49160
# RELAY_MAX_PORT=49415
# Default: the size of the port range.
# RELAY_MAX_ALLOCATIONS=256
# Per account. Each relayed peer connection uses one.
# RELAY_USER_ALLOCATIONS=16
# KiB/s per account and for the full relay.
# RELAY_USER_KIB_PER_SEC=1024
# RELAY_MAX_KIB_PER_SEC=65536
# Addresses the relay never sends to. Add the other public addresses of your servers.
# RELAY_DENIED_PEERS=198.51.100.0/24,2001:db8:1::/48
# Let the relay reach private addresses. LAN and development only.
# RELAY_ALLOW_PRIVATE=false
# Your own STUN or TURN servers as JSON. Every signed-in account gets these entries as they
# are, and a username and credential here never expire. Anyone who registers can use that
# TURN server until you change them. Prefer the built-in relay, or a TURN server with short
# lived credentials, over a fixed username and credential.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Logs
# Swagger UI at /api/swagger-ui. It needs a login token.
# SWAGGER_UI=false
# debug or trace also shows PeerJS connect lines.
# RUST_LOG=info
