# Copy to .env.local. A line that starts with "# KEY=" shows the default or an example.

# App
# full serves the API and the app. api-only serves only the API.
APP_MODE=full
# Use 0.0.0.0 for remote access.
HOST=127.0.0.1
# The public port.
SERVER_PORT=3000
# The internal Next.js port.
PORT=3001
# Change only if Next.js runs on another machine.
# FRONTEND_HOST=127.0.0.1
# Where non-API requests go in full mode. Default: http://127.0.0.1:${PORT}
# SERVER_PROXY_URL=http://127.0.0.1:3001
# API address for a frontend apart from the API (build time).
# NEXT_PUBLIC_API_URL=http://localhost:3000
# WebSocket address when it is not on the API origin (build time).
# NEXT_PUBLIC_WS_URL=https://gateway.example.com

# Instance
# INSTANCE_NAME=RChat
# The address people open. Set it in production.
# PUBLIC_URL=https://chat.example.com
# Host names the instance answers for when PUBLIC_URL is not set.
# ALLOWED_HOSTS=chat.example.com
# For an API, WebSocket or PeerJS server on another address.
# PUBLIC_API_URL=https://api.example.com/api
# PUBLIC_WS_URL=wss://gateway.example.com
# PUBLIC_PEERJS_URL=https://chat.example.com/peerjs
# Ed25519 seeds (base64url, comma separated) or PEM. Default: a key in the database.
# INSTANCE_SIGNING_KEY=

# Database
# A sqlite file or a postgres:// URL. Use Postgres for more than one process.
# DATABASE_URL=rchat.db
# Postgres pool size per process.
# DATABASE_MAX_CONNECTIONS=8
# DATABASE_MIN_CONNECTIONS=0
# DATABASE_ACQUIRE_TIMEOUT_SECS=30
# Sqlite read pool size. Default: CPU count, 2 to 8. 0 sends reads to the writer.
# DATABASE_READ_CONNECTIONS=4

# Secrets
# Changing it after first start ends every temporary server password and ticket.
# PASSWORD_PEPPER=
# Any secret also reads NAME_FILE=/path. Set one here to keep it out of the database; same value on all processes.
# PASSWORD_PEPPER_FILE=/run/secrets/rchat_pepper
# Signs relay (TURN) logins. Changing it ends relay logins within an hour.
# RELAY_SECRET=
# Signs P2P file tokens. Changing it ends the tokens that were given out.
# P2P_SECRET=

# Storage
# Set the first four to store uploads in an S3 bucket.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=rchat
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Uploads
# Most MiB of one account's files at once. 0 means no limit.
# UPLOAD_BUDGET_MIB=2048
# Most MiB of upload bodies in memory at once. At least 32.
# UPLOAD_BUFFER_MIB=256

# Scaling
# all, or a list of api, gateway, media, search, embeds, jobs, web, relay. Default: from APP_MODE.
# RCHAT_ROLES=all
# Use a password and a private network. No TLS (rediss://).
# REDIS_URL=redis://:change-me@127.0.0.1:6379
# Key prefix, so many deployments can share one Redis.
# REDIS_PREFIX=rchat
# Entries kept in the realtime stream. Minimum 1000. Same value on all processes.
# REDIS_HUB_MAXLEN=100000
# Proxy addresses or CIDR ranges. Their X-Forwarded-For gives the client address.
# TRUSTED_PROXIES=10.0.0.0/8,192.0.2.10
# Trust X-Forwarded-For from all peers. Prefer TRUSTED_PROXIES.
# TRUST_PROXY=false
# Docker only: on runs the PeerJS server in this container.
# RCHAT_PEERJS=on

# Limits
# Requests per second per IP.
# RATE_LIMIT_PER_SECOND=10
# RATE_LIMIT_BURST=60
# Realtime connections per account. The oldest closes past it.
# WS_CONNECTIONS_PER_USER=20
# New realtime connections per account: a burst, then this many per minute.
# WS_CONNECT_BURST=20
# WS_CONNECTS_PER_MINUTE=30
# Realtime connections per client address and process. Shared addresses count together.
# WS_SOCKETS_PER_IP=200
# Guest connections per client address and process. 0 turns guest connections off.
# WS_GUEST_SOCKETS_PER_IP=50
# Guest connections per process, all addresses together. 0 turns them off.
# WS_GUEST_SOCKETS_MAX=2000
# Rate limits and password budgets count per client address. Behind a proxy, set TRUSTED_PROXIES.

# Guests
# First start only. After that, the site admin panel controls it.
# GUESTS_ENABLED=true
# Days until an unused guest password grant expires. Limits: 2000 per password, 50 per network.
# GUEST_GRANT_DAYS=30

# Attachments
# First start only. P2P files stay in the sender's browser and have no size limit.
# P2P_ATTACHMENTS=true

# Profanity
# First start only: on or off.
# PROFANITY_FILTER=on
# all, none, or a list: messages, links, usernames, server_names, channel_names, role_names, file_names, bios, channel_topics, category_names.
# PROFANITY_TARGETS=all

# Previews
# Days to keep link previews that no message uses.
# EMBED_CACHE_DAYS=30

# Webhooks
# First start only. Lets servers POST events to URLs their managers choose.
# OUTGOING_WEBHOOKS=false
# Hosts webhooks may reach on private addresses. Use host:port: a bare host opens every port.
# WEBHOOK_ALLOWED_HOSTS=hooks.internal.example:8443,127.0.0.1:9000
# Plain http for the allowed hosts only.
# WEBHOOK_ALLOW_HTTP=false

# Voice
# Seconds until a voice room or call with one person ends.
# VOICE_IDLE_SECS=60
# Most people in one voice channel. 0 means no limit.
# VOICE_ROOM_MAX=25

# PeerJS
# The PeerJS server port.
# PEERJS_PORT=9001
# PeerJS connections per client address. Each tab uses two. 0 turns the limit off.
# PEERJS_PEERS_PER_IP=50
# PeerJS connections in all.
# PEERJS_CONCURRENT_LIMIT=5000
# PeerJS port for the browser (build time).
# NEXT_PUBLIC_PEERJS_PORT=9001
# PeerJS host for the browser (build time). Default: the page host.
# NEXT_PUBLIC_PEERJS_HOST=peer.example.com

# Relay
# Give calls public STUN servers from assets/stun_servers.json.
# PUBLIC_STUN=false
# How many, 1 to 4.
# PUBLIC_STUN_COUNT=3
# Run the built-in STUN and TURN relay. Use the same RELAY_ values on all processes.
# RELAY_ENABLED=false
# TURN needs RELAY_PUBLIC_IP.
# RELAY_TURN=true
# Default: the instance host.
# RELAY_HOST=relay.example.com
# RELAY_PORT=3478
# RELAY_PUBLIC_IP=203.0.113.10
# Reserve the port range: sysctl -w net.ipv4.ip_local_reserved_ports=49160-49415
# RELAY_MIN_PORT=49160
# RELAY_MAX_PORT=49415
# Default: the size of the port range.
# RELAY_MAX_ALLOCATIONS=256
# Per account. Each relayed P2P session, call or voice participant uses one.
# RELAY_USER_ALLOCATIONS=64
# KiB/s per account.
# RELAY_USER_KIB_PER_SEC=1024
# KiB/s for the full relay.
# RELAY_MAX_KIB_PER_SEC=65536
# Addresses the relay never sends to. Add the other public addresses of your servers.
# RELAY_DENIED_PEERS=198.51.100.0/24,2001:db8:1::/48
# Let the relay reach private addresses. LAN and development only.
# RELAY_ALLOW_PRIVATE=false
# Your own STUN or TURN servers as JSON. Every account gets them as they are. Prefer the built-in relay.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Logs
# Swagger UI at /api/swagger-ui. It needs a login token.
# SWAGGER_UI=false
# RUST_LOG=info
