# =============================================================================
# RChat Environment Configuration
# =============================================================================
# Copy this file to .env.local and update with your actual values:
#     cp .env.local.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Application Mode
# -----------------------------------------------------------------------------
# full:     Rust server (port 3000) proxies to Next.js (port 3001). Single entry point.
# api-only: Rust API server standalone. Next.js runs separately with rewrites.
APP_MODE=full

# -----------------------------------------------------------------------------
# Rust Server Configuration
# -----------------------------------------------------------------------------
# SERVER_PORT: Port where Rust server listens (default: 3000)
SERVER_PORT=3000

# HOST: Bind address for both Rust and Next.js servers (default: 127.0.0.1)
# For remote access (e.g., Codespaces, containers): set to 0.0.0.0
HOST=127.0.0.1

# SERVER_PROXY_URL: URL to proxy non-/api requests to the frontend (full mode only)
# Default: http://127.0.0.1:${PORT}
# SERVER_PROXY_URL=http://127.0.0.1:3001

# -----------------------------------------------------------------------------
# Next.js / Frontend Configuration
# -----------------------------------------------------------------------------
# PORT: Port where Next.js server listens (default: 3001 in full mode, 3000 in api-only)
PORT=3001

# NEXT_PUBLIC_API_URL: API base for api-only mode rewrites (default: http://HOST:SERVER_PORT)
# NEXT_PUBLIC_API_URL=http://localhost:3000

# NEXT_PUBLIC_WS_URL: gateway base when the WebSocket is served from another origin than
# the API, http(s):// or ws(s):// (default: NEXT_PUBLIC_API_URL, else the page origin)
# NEXT_PUBLIC_WS_URL=https://gateway.example.com

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DATABASE_URL: sqlite file holding everything (users, messages, media blobs), or a
# postgres:// URL (required when running more than one instance). Set-but-empty is a
# startup error.
# DATABASE_URL=rchat.db

# DATABASE_MAX_CONNECTIONS: pool size per instance (default: 8 for postgres, 1 for sqlite)
# DATABASE_MAX_CONNECTIONS=8

# DATABASE_MIN_CONNECTIONS: idle connections each instance keeps open (default: 0)
# DATABASE_MIN_CONNECTIONS=0

# DATABASE_ACQUIRE_TIMEOUT_SECS: wait for a free pool connection before failing (default: 30)
# DATABASE_ACQUIRE_TIMEOUT_SECS=30

# DATABASE_READ_CONNECTIONS: sqlite only, size of the separate read-only pool used by GET
# endpoints and auth (default: CPU count clamped to 2-8; 0 sends reads to the writer;
# in-memory databases always read from the writer)
# DATABASE_READ_CONNECTIONS=4

# -----------------------------------------------------------------------------
# S3 Media Storage (optional)
# -----------------------------------------------------------------------------
# When all four required vars are set, uploaded media blobs go to the
# S3-compatible bucket at key media/{id} instead of the database (path-style
# addressing, so minio works). Unset = blobs stay in the database.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=rchat
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Scaling (see README "Scaling")
# -----------------------------------------------------------------------------
# RCHAT_ROLES: service roles this instance runs, all (default) or a comma list of
# api, gateway, media, search, embeds, jobs, web. Unset = derived from APP_MODE
# (full = all, api-only = everything except web). CLI: --roles. A list with only part of
# the backend roles (e.g. api, or gateway,embeds) refuses to start without REDIS_URL and
# a postgres:// DATABASE_URL, since the other roles run in other processes.
# RCHAT_ROLES=all

# REDIS_URL: Redis-protocol server (Redis, Valkey, KeyDB, Dragonfly) that shares realtime
# state (presence, voice, calls, P2P hosting) and the embed job queue between instances.
# It is a trusted bus: require a password (requirepass or an ACL user) and keep it on a
# private network. redis:// only, rediss:// TLS is not supported yet. Credentials go in
# the URL (percent-encoded): redis://:password@host:6379 or redis://user:password@host:6379
# Unset = in-process hub for a single instance. Required (with a Postgres DATABASE_URL)
# when RCHAT_ROLES runs only part of the backend; set-but-empty is a startup error.
# REDIS_URL=redis://:change-me@127.0.0.1:6379

# REDIS_PREFIX: key prefix so several deployments can share one Redis (default: rchat)
# REDIS_PREFIX=rchat

# REDIS_HUB_MAXLEN: approximate number of entries kept in the realtime stream (default:
# 100000, minimum 1000). An instance that falls further behind re-bootstraps from the
# latest snapshot. Use the same value on every instance and change it cluster-wide.
# REDIS_HUB_MAXLEN=100000

# TRUSTED_PROXIES: comma list of IP addresses / CIDR ranges of your reverse proxies or
# load balancers. Rate limits then key on the client address from X-Forwarded-For
# (else X-Real-IP, else Forwarded), but only for requests whose TCP peer is in the list:
# the client is the right-most X-Forwarded-For hop that is not itself a trusted proxy,
# so entries a client wrote never count. Any other peer is keyed by its own address.
# Each listed proxy must set X-Forwarded-For itself (overwrite it or append its peer
# address): it is read before X-Real-IP, so a proxy that only sets X-Real-IP and passes
# the client's X-Forwarded-For through lets clients choose their own key.
# Unset = TRUST_PROXY decides. Wins over TRUST_PROXY when both are set.
# TRUSTED_PROXIES=10.0.0.0/8,192.0.2.10

# TRUST_PROXY: trust forwarded headers from ANY peer (default: false); the client is then
# the left-most X-Forwarded-For entry. Only for instances that are unreachable except
# through a proxy that OVERWRITES X-Forwarded-For with the client address, e.g. nginx
# "proxy_set_header X-Forwarded-For $remote_addr" (deploy/nginx.conf). Prefer
# TRUSTED_PROXIES.
# TRUST_PROXY=false

# RCHAT_PEERJS: Docker start script only, run the PeerServer in this container
# (on/off; default on when RCHAT_ROLES is unset or all)
# RCHAT_PEERJS=on

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# RATE_LIMIT_PER_SECOND: Token replenish rate per IP (default: 10)
# RATE_LIMIT_PER_SECOND=10

# RATE_LIMIT_BURST: Max burst of requests before limiting (default: 60)
# RATE_LIMIT_BURST=60

# -----------------------------------------------------------------------------
# Guests
# -----------------------------------------------------------------------------
# GUESTS_ENABLED: seeds the guests_enabled site setting on first startup only
# (default: true); afterwards the site admin panel toggle owns the value
# GUESTS_ENABLED=true

# GUEST_GRANT_DAYS: a guest grant (from entering a server password) expires after this
# many days unused; each use slides the window (default: 30)
# GUEST_GRANT_DAYS=30

# -----------------------------------------------------------------------------
# Link previews
# -----------------------------------------------------------------------------
# EMBED_CACHE_DAYS: cached link previews no message uses are deleted after this many days
# (default: 30)
# EMBED_CACHE_DAYS=30

# -----------------------------------------------------------------------------
# Voice
# -----------------------------------------------------------------------------
# VOICE_IDLE_SECS: a voice room or call with one occupant for this long is ended
# VOICE_IDLE_SECS=60
# VOICE_ROOM_MAX: most people in one voice channel; voice is a full mesh, so keep it small (0 = no limit)
# VOICE_ROOM_MAX=25

# -----------------------------------------------------------------------------
# PeerJS (P2P calls and files)
# -----------------------------------------------------------------------------
# PEERJS_PORT: port for the local PeerServer spawned by just dev/prod, and the port
# /api/instance advertises when PUBLIC_PEERJS_URL is unset (default: 9001)
# PEERJS_PORT=9001

# NEXT_PUBLIC_PEERJS_PORT: port the browser dials for PeerJS (default: 9001;
# host defaults to window.location.hostname)
# NEXT_PUBLIC_PEERJS_PORT=9001

# NEXT_PUBLIC_PEERJS_HOST: host the browser dials for PeerJS when the PeerServer lives
# on another host (default: window.location.hostname)
# NEXT_PUBLIC_PEERJS_HOST=peer.example.com

# -----------------------------------------------------------------------------
# Swagger UI
# -----------------------------------------------------------------------------
# Set SWAGGER_UI=false to disable Swagger UI (enabled by default, login required)
# SWAGGER_UI=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# RUST_LOG=info
# debug or trace also unhides the PeerServer "Client connected/disconnected" lines

# -----------------------------------------------------------------------------
# Instance identity (see README "Instances and identity")
# -----------------------------------------------------------------------------
# INSTANCE_NAME: display name announced at /api/instance (default: RChat)
# INSTANCE_NAME=RChat

# PUBLIC_URL: origin users open; the issuer of identity assertions and the base of
# every discovery URL. Set it in production (the server warns when it is unset while
# replicas share REDIS_URL).
# PUBLIC_URL=https://chat.example.com

# ALLOWED_HOSTS: without PUBLIC_URL, the Host names /api/instance may answer for, comma
# separated (host or host:port). Loopback hosts always work; any other Host gets the
# first entry, or localhost. X-Forwarded-Host/-Proto count only from TRUSTED_PROXIES.
# ALLOWED_HOSTS=chat.example.com

# PUBLIC_API_URL / PUBLIC_WS_URL / PUBLIC_PEERJS_URL: advertised URLs when they are not
# {PUBLIC_URL}/api, ws(s)://{host}/api/ws and {host}:9001/peerjs
# PUBLIC_API_URL=https://api.example.com/api
# PUBLIC_WS_URL=wss://gateway.example.com
# PUBLIC_PEERJS_URL=https://chat.example.com/peerjs

# INSTANCE_SIGNING_KEY: Ed25519 signing key(s), base64url 32-byte seeds separated by
# commas (first signs, the rest stay published) or PKCS#8 PEM. Unset = a key generated
# once in the database and shared by every replica.
# INSTANCE_SIGNING_KEY=
