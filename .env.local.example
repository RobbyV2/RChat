# Copy to .env.local. A line that starts with "# KEY=" shows the default or an example.

# App
# full serves the API and the app. api-only serves only the API.
APP_MODE=full
# Use 0.0.0.0 for remote access.
HOST=127.0.0.1
# The public port.
SERVER_PORT=3000
# The internal Next.js port.
PORT=3001
# Change only if Next.js runs on another machine.
# FRONTEND_HOST=127.0.0.1
# Where non-API requests go in full mode. Default: http://127.0.0.1:${PORT}
# SERVER_PROXY_URL=http://127.0.0.1:3001
# API address for a frontend apart from the API (build time).
# NEXT_PUBLIC_API_URL=http://localhost:3000
# WebSocket address when it is not on the API origin (build time).
# NEXT_PUBLIC_WS_URL=https://gateway.example.com

# Instance
# INSTANCE_NAME=RChat
# The address people open. Set it in production.
# PUBLIC_URL=https://chat.example.com
# Host names the instance answers for when PUBLIC_URL is not set.
# ALLOWED_HOSTS=chat.example.com
# For an API, WebSocket or PeerJS server on another address.
# PUBLIC_API_URL=https://api.example.com/api
# PUBLIC_WS_URL=wss://gateway.example.com
# PUBLIC_PEERJS_URL=https://chat.example.com/peerjs
# Ed25519 seeds (base64url, comma separated) or PEM. Default: a key in the database.
# INSTANCE_SIGNING_KEY=

# Database
# A sqlite file or a postgres:// URL. Use Postgres for more than one process.
# DATABASE_URL=rchat.db
# Postgres pool size per process, 1 to 1000.
# DATABASE_MAX_CONNECTIONS=8
# Connections the pool keeps open, 0 to 1000.
# DATABASE_MIN_CONNECTIONS=0
# Seconds to wait for a free connection, 1 to 3600.
# DATABASE_ACQUIRE_TIMEOUT_SECS=30
# Sqlite read pool size, 0 to 64. Default: CPU count, at least 2 and at most 8. 0 sends reads to the writer.
# DATABASE_READ_CONNECTIONS=4

# Secrets
# Changing it after first start ends every temporary server password and ticket.
# PASSWORD_PEPPER=
# Any secret also reads NAME_FILE=/path. Set one here to keep it out of the database; same value on all processes.
# PASSWORD_PEPPER_FILE=/run/secrets/rchat_pepper
# Signs relay (TURN) logins. Changing it ends relay logins within an hour.
# RELAY_SECRET=
# Signs P2P file tokens. Changing it ends the tokens that were given out.
# P2P_SECRET=

# Storage
# Set the first four to store uploads in an S3 bucket.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=rchat
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Uploads
# Largest upload in MiB, 1 to 512. Raise your proxy's body size to match (client_max_body_size 26m in deploy/nginx.conf).
# UPLOAD_MAX_MIB=25
# Most MiB of one account's files at once, 0 to 1048576. 0 means no limit.
# UPLOAD_BUDGET_MIB=2048
# Most MiB of upload bodies in memory at once, 32 to 1048576, and at least UPLOAD_MAX_MIB.
# Give it at least twice UPLOAD_MAX_MIB. One account holds at most a quarter of it,
# three uploads (up to half of it) or one upload, whichever is most.
# UPLOAD_BUFFER_MIB=256

# Messages
# Longest message in characters, 1 to 100000.
# MESSAGE_MAX_CHARS=4000

# Scaling
# all, or a list of api, gateway, media, search, embeds, jobs, web, relay, sfu. Default: from APP_MODE.
# RCHAT_ROLES=all
# Use a password and a private network. No TLS (rediss://).
# REDIS_URL=redis://:change-me@127.0.0.1:6379
# Key prefix, so many deployments can share one Redis.
# REDIS_PREFIX=rchat
# Entries kept in the realtime stream, 1000 to 100000000. Same value on all processes.
# REDIS_HUB_MAXLEN=100000
# Proxy addresses or CIDR ranges. Their X-Forwarded-For gives the client address.
# TRUSTED_PROXIES=10.0.0.0/8,192.0.2.10
# Trust X-Forwarded-For from all peers. Prefer TRUSTED_PROXIES.
# TRUST_PROXY=false
# Docker only: on runs the PeerJS server in this container.
# RCHAT_PEERJS=on

# Limits
# A limit outside its range stops the server at start.
# Requests per second per IP, 1 to 1000.
# RATE_LIMIT_PER_SECOND=10
# Requests per IP in a burst, 1 to 1000000.
# RATE_LIMIT_BURST=60
# Realtime connections per account, 1 to 10000. The oldest closes past it.
# WS_CONNECTIONS_PER_USER=20
# New realtime connections per account in a burst, 1 to 10000.
# WS_CONNECT_BURST=20
# New realtime connections per account per minute after the burst, 1 to 60000.
# WS_CONNECTS_PER_MINUTE=30
# Realtime connections per client address and process, 1 to 1000000. Shared addresses count together.
# WS_SOCKETS_PER_IP=200
# Guest connections per client address and process, 0 to 1000000. 0 turns guest connections off.
# WS_GUEST_SOCKETS_PER_IP=50
# Guest connections per process, all addresses together, 0 to 1000000. 0 turns them off.
# WS_GUEST_SOCKETS_MAX=2000
# Rate limits and password budgets count per client address. Behind a proxy, set TRUSTED_PROXIES.

# Guests
# First start only. After that, the Features section of the site admin panel controls it.
# GUESTS_ENABLED=true
# Days until an unused guest password grant expires, 1 to 3650. Limits: 2000 per password, 50 per network.
# GUEST_GRANT_DAYS=30

# Attachments
# First start only. P2P files stay in the sender's browser and have no size limit.
# P2P_ATTACHMENTS=true

# Accounts
# First start only: who can sign up with a password, open, sso or closed. Keep it open until your own account exists.
# AUTH_REGISTRATION=open
# First start only: password sign-in, on or off. Off stops new passwords, sign-up included. Existing passwords still work.
# AUTH_PASSWORD_LOGIN=on
# First start only: changing display names, on or off.
# FEATURE_DISPLAY_NAMES=on
# First start only: the tour for new accounts, on or off.
# FEATURE_ONBOARDING=on
# First start only: setting and resetting backup phrases, on or off.
# FEATURE_BACKUP_PHRASE=on

# P2P
# First start only: P2P servers and conversations in the app, on or off. Off hides them and keeps data on devices.
# FEATURE_P2P=on

# Other instances
# First start only: adding other instances in the web app this site serves, on or off. The desktop and mobile apps and other web apps ignore it.
# FEATURE_CLIENT_OTHER_INSTANCES=on

# Profanity
# First start only: the instance filter, on or off. Each account's own display filter is separate and on by default.
# PROFANITY_FILTER=off
# What the instance filter checks when on: all, none, or a list: messages, links, usernames, server_names, channel_names, role_names, file_names, bios, channel_topics, category_names.
# PROFANITY_TARGETS=all

# Previews
# Days to keep link previews that no message uses, 1 to 3650.
# EMBED_CACHE_DAYS=30

# Webhooks
# First start only. Lets servers POST events to URLs their managers choose.
# OUTGOING_WEBHOOKS=false
# Hosts webhooks may reach on private addresses. Use host:port: a bare host opens every port.
# WEBHOOK_ALLOWED_HOSTS=hooks.internal.example:8443,127.0.0.1:9000
# Plain http for the allowed hosts only.
# WEBHOOK_ALLOW_HTTP=false

# Voice
# Seconds until a voice room or call with one person ends, 5 to 86400.
# VOICE_IDLE_SECS=60
# Most people in one voice channel, 0 to 10000. 0 means no limit.
# VOICE_ROOM_MAX=25

# Media server (SFU) for calls
# Run it: on or off. It runs in processes with the sfu role.
# SFU_ENABLED=false
# First start only: calls use the media server when it runs, on or off.
# FEATURE_SFU=off
# Most people in one call through it, 2 to 10000.
# SFU_MAX_PARTICIPANTS=100
# Most forwarded streams per process, 1 to 1000000.
# SFU_MAX_STREAMS=2000
# KiB/s per account, 1 to 1048576.
# SFU_USER_KIB_PER_SEC=4096

# PeerJS
# The PeerJS server port.
# PEERJS_PORT=9001
# PeerJS connections per client address. Each tab uses two. 0 turns the limit off.
# PEERJS_PEERS_PER_IP=50
# PeerJS connections in all.
# PEERJS_CONCURRENT_LIMIT=5000
# PeerJS port for the browser (build time). Default: the port of PUBLIC_PEERJS_URL, or of
# PEERJS_PORT, when the instance is on the page host; else 9001.
# NEXT_PUBLIC_PEERJS_PORT=9001
# PeerJS host for the browser (build time). Default: the page host.
# NEXT_PUBLIC_PEERJS_HOST=peer.example.com

# Relay
# Give calls public STUN servers from assets/stun_servers.json.
# PUBLIC_STUN=false
# How many, 1 to 4.
# PUBLIC_STUN_COUNT=3
# Run the built-in STUN and TURN relay. Use the same RELAY_ values on all processes.
# RELAY_ENABLED=false
# TURN needs RELAY_PUBLIC_IP.
# RELAY_TURN=true
# Default: the instance host.
# RELAY_HOST=relay.example.com
# RELAY_PORT=3478
# RELAY_PUBLIC_IP=203.0.113.10
# Reserve the port range: sysctl -w net.ipv4.ip_local_reserved_ports=49160-49415
# RELAY_MIN_PORT=49160
# RELAY_MAX_PORT=49415
# Relay allocations in all, 1 to 65535 and at most the size of the port range. Default: the size of the port range.
# RELAY_MAX_ALLOCATIONS=256
# Relay allocations per account, 1 to 65535. Each relayed P2P session, call or voice participant uses one.
# RELAY_USER_ALLOCATIONS=64
# KiB/s per account, 1 to 10485760.
# RELAY_USER_KIB_PER_SEC=1024
# KiB/s for the full relay, 1 to 10485760.
# RELAY_MAX_KIB_PER_SEC=65536
# Addresses the relay never sends to. Add the other public addresses of your servers.
# RELAY_DENIED_PEERS=198.51.100.0/24,2001:db8:1::/48
# Let the relay reach private addresses. LAN and development only.
# RELAY_ALLOW_PRIVATE=false
# Your own STUN or TURN servers as JSON. Every account gets them as they are. Prefer the built-in relay.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Reports
# First start only: reports to a server's moderators, on or off.
# FEATURE_SERVER_REPORTS=on
# First start only: reports to the instance, on or off.
# FEATURE_INSTANCE_REPORTS=on
# Hours before one person can report the same account or its messages again, 0 to 8760. 0 means no wait.
# REPORT_SAME_TARGET_HOURS=72
# Different accounts one person can report per day, 0 to 10000. 0 means no cap.
# REPORT_TARGETS_PER_DAY=3
# Reports one person can send per week, 0 to 100000. 0 means no cap.
# REPORT_MAX_PER_WEEK=10
# Days to keep closed reports, 0 to 3650. 0 keeps them forever.
# REPORT_RETENTION_DAYS=180

# Encryption
# First start only: end-to-end encryption, on or off.
# E2EE=off
# Guests in one encrypted group, 0 to 5000. 0 means no guests.
# E2EE_GUESTS_PER_GROUP=500
# Days to keep encryption key material for catching up, 1 to 69.
# E2EE_KEY_RETENTION_DAYS=30
# First start only: compliance archive in new encrypted spaces, on or off.
# E2EE_COMPLIANCE=off

# P2P backups
# Most MiB of P2P backups per account, 0 to 512. 0 turns backups off.
# P2P_BACKUP_MAX_MIB=64
# First start only: P2P backups on the instance, on or off.
# FEATURE_P2P_BACKUP=on

# Widgets
# First start only: embeddable widgets, on or off.
# WIDGETS=on
# First start only: sending from widgets and Quick join, on or off.
# FEATURE_WIDGET_CHAT=on
# First start only: read-only widget links, on or off.
# FEATURE_WIDGET_READ_LINKS=on
# Quick joins per client address per hour, 1 to 10000.
# WIDGET_QUICK_JOINS_PER_HOUR=10
# Live viewers per widget and process, 0 to 1000000. 0 means no cap.
# WIDGET_VIEWERS_MAX=5000
# First start only: widgets for P2P servers through a bridge, on or off.
# WIDGET_BRIDGE=off
# P2P servers the bridge belongs to, 1 to 10000.
# WIDGET_BRIDGE_SERVERS_MAX=50

# Logs
# Swagger UI at /api/v1/swagger-ui. It needs a login token.
# SWAGGER_UI=false
# RUST_LOG=info
