# Copy to deploy/k8s/secrets.env (gitignored) and fill in every value; kustomize refuses
# to build the base without that file, the role pods do not start without DATABASE_URL
# and REDIS_URL, and Valkey does not start with an empty VALKEY_PASSWORD.
#
#   cp deploy/k8s/secrets.env.example deploy/k8s/secrets.env
#   openssl rand -hex 32    # a strong, URL-safe VALKEY_PASSWORD
#
# Lines are KEY=value with no quotes. Any other variable added here (for example
# S3_ACCESS_KEY and S3_SECRET_KEY) reaches every role pod through envFrom.

# Postgres the role pods share (percent-encode special characters in the password).
# DATABASE_URL=postgres://rchat:<password>@<host>:5432/rchat

# The password rchat-valkey requires.
# VALKEY_PASSWORD=<output of openssl rand -hex 32>

# The realtime bus URL, carrying the same password. Point it at a managed Redis/Valkey
# instead if you use one (redis://user:password@host:6379 for an ACL user).
# REDIS_URL=redis://:<VALKEY_PASSWORD>@rchat-valkey:6379
