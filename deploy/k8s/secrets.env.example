# Copy to deploy/k8s/secrets.env (gitignored) and fill in all values:
#
#   cp deploy/k8s/secrets.env.example deploy/k8s/secrets.env
#   openssl rand -hex 32    # a strong, URL-safe VALKEY_PASSWORD
#
# Lines are KEY=value without quotes. Other variables here (for example S3_ACCESS_KEY) go to
# all role pods.

# Postgres for all role pods. Percent-encode special characters in the password.
# DATABASE_URL=postgres://rchat:<password>@<host>:5432/rchat

# The password of rchat-valkey.
# VALKEY_PASSWORD=<output of openssl rand -hex 32>

# The realtime bus with the same password, or a managed Redis or Valkey.
# REDIS_URL=redis://:<VALKEY_PASSWORD>@rchat-valkey:6379

# Optional Ed25519 signing key (base64url 32-byte seed). Older keys follow, separated by commas.
# INSTANCE_SIGNING_KEY=<output of openssl rand 32 | basenc --base64url | tr -d =>
