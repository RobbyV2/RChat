{
  "name": "@rchat/web",
  "description": "RChat web client",
  "version": "0.2.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash -c 'exec next dev -H \"${FRONTEND_HOST:-${HOST:-localhost}}\"'",
    "dev:desktop": "next dev -H 127.0.0.1 -p 1430",
    "build": "next build",
    "build:desktop": "STATIC_EXPORT=true next build",
    "start": "bash -c 'HOSTNAME=${FRONTEND_HOST:-${HOST:-0.0.0.0}} exec bun .next/standalone/apps/web/server.js'",
    "test:ui": "bun test app"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@tauri-apps/api": "^2.12.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "emojibase-data": "^18.0.0",
    "highlight.js": "^11.12.0",
    "idb": "8.0.4",
    "jose": "6.2.13",
    "jsqr": "1.4.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.61.0",
    "minidenticons": "^4.2.1",
    "minisearch": "7.2.0",
    "next": "^16.4.3",
    "peerjs": "1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uqr": "^0.1.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "6.2.6",
    "tailwindcss": "^4.3.3"
  }
}
