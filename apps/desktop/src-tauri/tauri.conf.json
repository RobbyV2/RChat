{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RChat",
  "mainBinaryName": "rchat",
  "version": "../../web/package.json",
  "identifier": "io.github.robbyv2.rchat",
  "build": {
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../../web/out",
    "beforeDevCommand": {
      "script": "bun run dev:desktop",
      "cwd": "../../..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "bun run build:desktop",
      "cwd": "../../.."
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "RChat",
        "url": "index.html",
        "create": false,
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#141218"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://localhost:* http://127.0.0.1:*",
        "media-src": "'self' data: blob: mediastream: https: http://localhost:* http://127.0.0.1:*",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:*",
        "worker-src": "'self' blob:",
        "manifest-src": "'self'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "RChat",
    "category": "SocialNetworking",
    "shortDescription": "Anonymous Material chat",
    "longDescription": "Desktop client for RChat instances.",
    "homepage": "https://github.com/RobbyV2/RChat",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["rchat"]
      },
      "mobile": [
        {
          "scheme": ["rchat"],
          "appLink": false
        }
      ]
    },
    "updater": {
      "pubkey": "RCHAT_UPDATER_PUBKEY_PLACEHOLDER",
      "endpoints": ["https://github.com/RobbyV2/RChat/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
