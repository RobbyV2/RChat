pkgname=rchat-bin
pkgver={{PKGVER}}
pkgrel=1
pkgdesc='Desktop client for RChat instances'
arch=('x86_64')
url='https://github.com/{{REPO}}'
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'hicolor-icon-theme')
provides=('rchat')
conflicts=('rchat' 'rchat-weekly-bin')
options=('!debug' '!strip')
source=("{{DEB_FILE}}::{{DEB_URL}}"
        "LICENSE::{{LICENSE_URL}}")
sha256sums=('{{DEB_SHA256}}'
            '{{LICENSE_SHA256}}')

package() {
  bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
